%ifnnum __RXDSTRUC_MAC__
%assign __RXDSTRUC_MAC__ 1


%ifdef RxDOS_ROMVERSION
 %iassign ROM_IDENTIFICATION 8			; DOS is in ROM
%else
 %iassign ROM_IDENTIFICATION 0			; DOS is not in ROM
%endif

numdef RXDOS720N, 1

		; Default Configuration Parameters
%assign DEFAULT_FILES		16		; MS-DOS default: 8
%assign DEFAULT_BUFFERS_X	30		; MS-DOS default: 15
%assign DEFAULT_BUFFERS_Y	0		; MS-DOS default: 0
%assign DEFAULT_BUFFERS		DEFAULT_BUFFERS_X
%assign DEFAULT_FCBS_X		4		; MS-DOS default: 4
%assign DEFAULT_FCBS_Y		4		; MS-DOS default: 4
%assign DEFAULT_FCBS		DEFAULT_FCBS_X
%assign DEFAULT_LASTDRIVE	5		; MS-DOS default: 5
%assign DEFAULT_FCBOPENMODE	2		; change only if you want read-only
%assign DEFAULT_STACKS		9
%define DEFAULT_CODEPAGE	CODEPAGE_UNITEDSTATES	; default code page
%define DEFAULT_COUNTRYCODE	COUNTRY_UNITEDSTATES	; default country code

%assign DEFAULT_ENVIRONMENT	2*1024		; bytes default environment space
%assign DEFAULT_MINENVIRONMENT	160		; MS-DOS minimum
%assign DEFAULT_MAXENVIRONMENT	32*1024		; MS-DOS maximum



		; Maximal allowable configuration parameters
%assign CONFIGMIN_BUFFERS_X	1
%assign CONFIGMIN_BUFFERS_Y	1
%assign CONFIGMIN_FILES		8		; technically, 5
%assign CONFIGMIN_FCBS_X	1
%assign CONFIGMIN_FCBS_Y	1
%assign CONFIGMIN_STACKS_X	8
%assign CONFIGMIN_STACKS_Y	32
%assign CONFIGMIN_LASTDRIVE	1

%assign CONFIGMAX_BUFFERS_X	99
%assign CONFIGMAX_BUFFERS_Y	8
%assign CONFIGMAX_BUFFERS	CONFIGMAX_BUFFERS_X
%assign CONFIGMAX_FILES		255
%assign CONFIGMAX_FCBS_X	255
%assign CONFIGMAX_FCBS_Y	255
%assign CONFIGMAX_STACKS_X	64
%assign CONFIGMAX_STACKS_Y	512
%assign CONFIGMAX_LASTDRIVE	32


		; equate labels bit00-bit31 to their meaning
	%macro temp_ 1.nolist
%assign bit%1	1<<%1
%assign b%1	1<<%1		; either "b{it}{0-9} equ ..." or "b{it}{10-31} equ ..."
	%if %1 < 10
%assign bit0%1	1<<%1
%assign b0%1	1<<%1		; "b{it}0{0-9} equ ..." with padding zero
	%endif
	%endmacro
	
	%push
%assign %$count 0		; start with bit00
	%rep 32			; bit00-31
	temp_ %$count
%assign %$count %$count+1	; count up
	%endrep
	%pop

%unmacro temp_ 1.nolist

		; DOS capability flags
		; for Int21.3360
DOSCAP_LBA28		equ b00	; supports LBA28 disk access (<= 128 GiB)
DOSCAP_LBA32		equ b01	; supports LBA32 disk access (<= 2 TiB)
DOSCAP_LBA48		equ b02	; supports LBA48 disk access (<= 128 PiB)
		;  Note: The LBA services have to be provided by the ROM-BIOS.
DOSCAP_IRT0		equ b03	; provides interrupt restoration table at 70h:100h
				; (count of entries at 70h:FFh); restored on Int19
DOSCAP_DISKCHANGE	equ b04	; supports changing logical device for A: on
				; single floppy system; uses the byte at 0h:504h
DOSCAP_REENTRANT	equ b05	; Reentrant DOS stack allocation
DOSCAP_LONGLSEEK	equ b08	; provides long lseek (Int21.7142)
DOSCAP_LFNAWARE		equ b09	; excludes LFN entries from SFN functions
DOSCAP_LFNSUPPORT	equ b10	; provides LFN functions (Int21.71)
DOSCAP_64KIBCLUSTER	equ b11	; supports FAT cluster sizes of 64 KiB
DOSCAP_128KIBCLUSTER	equ b12	; supports FAT cluster sizes of 128 KiB
DOSCAP_FAT32		equ b13	; supports FAT32 partitions
				; & provides FAT32 services (Int21.7302-.7305)
DOSCAP_FCB_TABLE	equ b14	; Utilises seperated System FCB tables for FCB operations (else SFTs)



